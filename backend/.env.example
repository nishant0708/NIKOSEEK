DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<database-password>@aws-<region>.pooler.supabase.com:5432/postgres
JWT_SECRET_KEY=replace-this-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
SUPABASE_STORAGE_BUCKET=job-files
GEMINI_API_KEY=replace-with-your-vertex-ai-express-mode-api-key
AI_MODEL=gemini-3.5-flash-lite
# Optional free-tier Groq fallback when all configured Gemini models fail.
# Create a free API key at console.groq.com; it is not your old xAI/Grok key.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1
CORS_ORIGINS=http://localhost:5173
# Optional SMTP configuration for automatic application receipt emails.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_RECEIPT_EMAIL=
SMTP_USE_TLS=true
